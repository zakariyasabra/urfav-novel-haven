# ─────────────────────────────────────────────────────────────────
# UR Fav Novel — Environment Configuration
# Copy this file to `.env` and fill in your own values.
# NEVER commit `.env` to git. Only `.env.example` should be committed.
# ─────────────────────────────────────────────────────────────────

# ── Supabase (bring your own project from https://supabase.com) ──
# Client-side (safe to expose, embedded in the built JS bundle):
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Server-side (only used if you build with SSR — safe to omit for static SPA):
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX"
# SERVICE ROLE — keep secret, never ship to the browser:
SUPABASE_SERVICE_ROLE_KEY="sb_secret_XXXXXXXXXXXXXXXXXXXXXXXX"

# ── Site configuration ──
# Public URL where this site is deployed (used for canonical URLs, sitemap, OG tags).
# NO trailing slash.
VITE_SITE_URL="https://your-domain.com"
VITE_SITE_NAME="UR Fav Novel"
