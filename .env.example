# ─────────────────────────────────────────────────────────────────
# FAVNOL — Environment Configuration
# Copy this file to `.env` and fill in your own values.
# NEVER commit `.env` to git.
# ─────────────────────────────────────────────────────────────────

# ── Supabase — CLIENT (embedded into the built JS bundle at build time) ──
# These MUST be present when you run `npm run build` — Vite inlines them.
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# ── Supabase — SERVER (read at runtime by SSR / server functions) ──
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX"
# SERVICE ROLE — server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_XXXXXXXXXXXXXXXXXXXXXXXX"

# ── Site configuration ──
# Public URL where the site is deployed (canonical URLs, sitemap, OG tags).
# NO trailing slash. Required at build time.
VITE_SITE_URL="https://your-domain.com"
VITE_SITE_NAME="FAVNOL"
# Server-side mirror (used by /api/sitemap.xml). Same value as VITE_SITE_URL.
SITE_URL="https://your-domain.com"

# ── AI (optional — used by admin auto-translate feature) ──
LOVABLE_API_KEY=""

# ── Node.js runtime (CloudClusters / VPS) ──
# Nitro build preset. Use `node-server` for standard Node hosting.
NITRO_PRESET="node-server"
# Port the Node server listens on. CloudClusters usually injects PORT.
PORT="3000"
NODE_ENV="production"
